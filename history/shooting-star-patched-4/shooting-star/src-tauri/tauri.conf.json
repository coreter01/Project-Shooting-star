{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Astra Assistant",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true,
        "execute": false,
        "sidecar": true,
        "scope": [
          { "name": "bin/bridge", "sidecar": true, "args": true }
        ]
      },
      "dialog": { "open": true, "save": true },
      "fs": { "readFile": true, "scope": ["$HOME/*", "$HOME/**", "$RESOURCE/*"] },
      "protocol": { "asset": true, "assetScope": ["$HOME/*", "$HOME/**"] },
      "path": { "all": true },
      "os": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.astaronova.astra-assistant",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
      "externalBin": ["bin/bridge"],
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "security": { "csp": null },
    "windows": [
      {
        "title": "Astra Assistant",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ]
  }
}
