{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Shooting Star",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true,
        "execute": false,
        "sidecar": true,
        "scope": [
          { "name": "bin/bridge", "sidecar": true, "args": true }
        ]
      },
      "dialog": { "open": true, "save": true },
      "fs": { "readFile": true, "scope": ["$HOME/*", "$HOME/**", "$RESOURCE/*"] },
      "path": { "all": true },
      "os": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.shootingstar.trolysieuluoi",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
      "externalBin": ["bin/bridge"]
    },
    "security": { "csp": null },
    "windows": [
      {
        "title": "Shooting Star — Trợ Lý Siêu Lười",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ]
  }
}
